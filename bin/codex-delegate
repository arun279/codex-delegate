#!/usr/bin/env -S python3 -I -S
# codex-delegate: one foreground Codex turn with bounded process-group cleanup.

from __future__ import annotations

import sys

if not sys.flags.isolated or not sys.flags.no_site:
    print("codex-delegate: the launcher must run under python3 -I -S", file=sys.stderr)
    raise SystemExit(2)

# Startup isolation is verified before importing modules that can be shadowed.
import argparse
import errno
import fcntl
import json
import os
import platform
import re
import secrets
import selectors
import shutil
import signal
import stat
import subprocess
import time
from pathlib import Path
from types import FrameType
from typing import BinaryIO, TypedDict, cast

PROGRAM = "codex-delegate"
DEFAULT_DEADLINE = 7200
MAX_DEADLINE = 12960
RUNNER_WAIT_SECONDS = 110
RUNNER_STARTUP_SECONDS = 60
EVENT_LIMIT = 16 * 1024 * 1024
LINE_LIMIT = 1024 * 1024
READ_BATCH = 32
TERMINAL_SETTLE_LIMIT_SECONDS = 2.5
RUNNER_PID_RECORD = re.compile(rb"CODEX_DELEGATE_LAUNCHER_PID=([1-9][0-9]*)\n\Z")
RUNNER_RUNID_RECORD = re.compile(rb"CODEX_DELEGATE_RUNID=(runner-[0-9a-f]{32})\n\Z")
RUNNER_END_RECORD = re.compile(rb"CODEX_DELEGATE_LAUNCHER_ENDED=([1-9][0-9]*)\n\Z")
TOKEN = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*\Z")
EXIT = {
    "COMPLETED": 0,
    "FAILED": 10,
    "DEADLINE": 11,
    "LAUNCH_ERROR": 12,
    "CLEANUP_FAILED": 13,
    "STREAM_ERROR": 17,
    "PLATFORM_UNSUPPORTED": 18,
    "NO_TERMINAL_EVENT": 21,
    "OUTPUT_MISSING": 23,
}


class Arguments(argparse.Namespace):
    command: str
    prompt_stdin: bool
    prompt_file: str | None
    sandbox: str
    network: bool
    cwd: str
    add_dir: list[str]
    schema: str | None
    model: str | None
    effort: str | None
    deadline: int
    runid: str | None
    runner_handoff: bool


class Model(TypedDict):
    slug: str
    efforts: list[str]
    default: str
    priority: int
    visible: bool


class RunContext(TypedDict):
    runid: str
    model: str
    effort: str
    sandbox: str
    deadline: int
    final_path: str
    events_path: str
    stderr_path: str


class Status(TypedDict):
    schema_version: int
    runid: str
    verdict: str
    exit_code: int
    diagnostic: str | None
    signal: str | None
    model: str
    effort: str
    sandbox: str
    deadline_s: int
    duration_s: float
    process_exit_code: int | None
    terminal_event: str | None
    final_message_path: str | None
    events_path: str
    stderr_path: str


class SignalNotice(TypedDict):
    number: int | None
    at: float | None


class UserError(Exception):
    pass


class PromptDeadline(Exception):
    pass


class PromptStopped(Exception):
    def __init__(self, number: int) -> None:
        super().__init__(number)
        self.number = number


def positive_deadline(raw: str) -> int:
    try:
        value = int(raw)
    except ValueError as error:
        raise argparse.ArgumentTypeError("must be a positive integer") from error
    if value < 1 or value > MAX_DEADLINE:
        raise argparse.ArgumentTypeError(f"must be between 1 and {MAX_DEADLINE}")
    return value


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        prog=PROGRAM,
        description="Run one Codex exec turn and return its final message and status.",
        epilog=(
            "exit codes: 0 COMPLETED, 10 FAILED, 11 DEADLINE, 12 LAUNCH_ERROR, "
            "13 CLEANUP_FAILED, 17 STREAM_ERROR, 18 PLATFORM_UNSUPPORTED, "
            "21 NO_TERMINAL_EVENT, 23 OUTPUT_MISSING; a stopped run exits 128+signal"
        ),
        allow_abbrev=False,
    )
    commands = result.add_subparsers(dest="command", required=True)
    run = commands.add_parser("run", help="run one blocking Codex exec turn", allow_abbrev=False)
    prompts = run.add_mutually_exclusive_group(required=True)
    prompts.add_argument("--prompt-stdin", action="store_true")
    prompts.add_argument("--prompt-file")
    run.add_argument(
        "--sandbox", required=True, choices=("read-only", "workspace-write", "danger-full-access")
    )
    run.add_argument("--network", action="store_true")
    run.add_argument("--cwd", default=os.getcwd())
    run.add_argument("--add-dir", action="append", default=[])
    run.add_argument("--schema")
    run.add_argument("--model")
    run.add_argument("--effort")
    run.add_argument("--deadline", type=positive_deadline, default=DEFAULT_DEADLINE)
    run.add_argument("--runid")
    run.add_argument("--runner-handoff", action="store_true", help=argparse.SUPPRESS)
    commands.add_parser("models", help="show the live model and effort catalog")
    return result


def fail(message: str) -> int:
    print(f"{PROGRAM}: {message}", file=sys.stderr)
    return 2


def canonical_dir(raw: str, label: str) -> str:
    path = os.path.realpath(os.path.abspath(raw))
    if not os.path.isdir(path):
        raise UserError(f"{label} is not a directory: {raw}")
    return path


def readable_file(raw: str, label: str) -> str:
    path = os.path.realpath(os.path.abspath(raw))
    if not os.path.isfile(path) or not os.access(path, os.R_OK):
        raise UserError(f"cannot read {label}: {raw}")
    return path


def paths_overlap(first: str, second: str) -> bool:
    try:
        common = os.path.commonpath((first, second))
    except ValueError:
        return False
    return common in (first, second)


def secure_run_root() -> str:
    raw = os.environ.get("CODEX_DELEGATE_HOME", str(Path.home() / ".codex-delegate"))
    absolute = os.path.abspath(raw.rstrip(os.sep) or os.sep)
    if absolute == os.sep:
        raise UserError("run storage must not be the filesystem root")
    if os.path.lexists(absolute) and os.path.islink(absolute):
        raise UserError(f"run storage must not be a symlink: {absolute}")
    physical = os.path.realpath(absolute)
    if physical != absolute:
        raise UserError(f"run storage must not traverse a symlink: {absolute}")
    os.makedirs(physical, mode=0o700, exist_ok=True)
    if not os.path.isdir(physical):
        raise UserError(f"run storage is not a directory: {physical}")
    current_uid = os.getuid()
    cursor = physical
    while True:
        state = os.stat(cursor)
        if state.st_uid not in (0, current_uid):
            raise UserError(f"run storage ancestor has another owner: {cursor}")
        mode = state.st_mode & 0o7777
        if mode & 0o022 and not mode & 0o1000:
            raise UserError(f"run storage ancestor is writable by other users: {cursor}")
        if cursor == os.sep:
            break
        cursor = os.path.dirname(cursor)
    if os.stat(physical).st_uid != current_uid:
        raise UserError(f"run storage must be owned by the current user: {physical}")
    os.chmod(physical, 0o700)
    return physical


def catalog(codex: str) -> list[Model]:
    try:
        completed = subprocess.run(  # noqa: S603 -- Run the PATH-resolved Codex binary.
            (codex, "debug", "models"),
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=15,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise UserError(f"cannot read the live Codex model catalog: {error}") from error
    if completed.returncode != 0:
        detail = completed.stderr.strip()
        suffix = f": {detail}" if detail else ""
        raise UserError(
            f"cannot read the live Codex model catalog (exit {completed.returncode}){suffix}"
        )
    try:
        raw = json.loads(completed.stdout)
        entries = raw["models"]
    except (KeyError, TypeError, json.JSONDecodeError) as error:
        raise UserError("the live Codex model catalog is invalid") from error
    if not isinstance(entries, list) or not entries:
        raise UserError("the live Codex model catalog has no models")
    models: list[Model] = []
    seen: set[str] = set()
    for index, entry in enumerate(entries):
        if not isinstance(entry, dict):
            raise UserError(f"the live Codex model catalog has an invalid entry at index {index}")
        slug = entry.get("slug")
        advertised = entry.get("supported_reasoning_levels")
        if not isinstance(slug, str) or not TOKEN.fullmatch(slug) or slug in seen:
            raise UserError(f"the live Codex model catalog has an invalid slug at index {index}")
        if not isinstance(advertised, list) or not advertised:
            raise UserError(f"the live Codex model catalog has no efforts for {slug}")
        efforts: list[str] = []
        for raw_effort in advertised:
            effort = raw_effort.get("effort") if isinstance(raw_effort, dict) else None
            if not isinstance(effort, str) or not TOKEN.fullmatch(effort) or effort in efforts:
                raise UserError(f"the live Codex model catalog has invalid efforts for {slug}")
            efforts.append(effort)
        default = entry.get("default_reasoning_level")
        if default not in efforts:
            default = next(
                (
                    item
                    for item in ("medium", "low", "high", "xhigh", "max", "ultra")
                    if item in efforts
                ),
                efforts[0],
            )
        priority = entry.get("priority")
        if isinstance(priority, bool) or not isinstance(priority, int):
            priority = 1_000_000 + index
        models.append(
            {
                "slug": slug,
                "efforts": efforts,
                "default": default,
                "priority": priority,
                "visible": entry.get("visibility") != "hide",
            }
        )
        seen.add(slug)
    return models


def resolve_pair(
    models: list[Model] | None, requested_model: str | None, requested_effort: str | None
) -> tuple[str, str]:
    if requested_model is not None and not TOKEN.fullmatch(requested_model):
        raise UserError("--model must contain only letters, digits, '.', '_', and '-'")
    if requested_effort is not None and not TOKEN.fullmatch(requested_effort):
        raise UserError("--effort must contain only letters, digits, '.', '_', and '-'")
    if models is None:
        if requested_model is None or requested_effort is None:
            raise UserError(
                "the model catalog is required unless --model and --effort are both set"
            )
        return requested_model, requested_effort
    if requested_model is None:
        visible = [model for model in models if model["visible"]]
        if not visible:
            raise UserError("the live Codex model catalog has no visible default")
        selected = min(visible, key=lambda item: (item["priority"], item["slug"]))
    else:
        matched = next((item for item in models if item["slug"] == requested_model), None)
        if matched is None:
            available = ", ".join(item["slug"] for item in models)
            raise UserError(f"--model {requested_model} is not in the live catalog ({available})")
        selected = matched
    effort = requested_effort or selected["default"]
    if effort not in selected["efforts"]:
        supported = ", ".join(selected["efforts"])
        raise UserError(f"--effort {effort} is not supported for {selected['slug']} ({supported})")
    return selected["slug"], effort


def allocate_run(root: str, requested: str | None, runner_handoff: bool) -> tuple[str, str]:
    if requested is not None and (requested in (".", "..") or not TOKEN.fullmatch(requested)):
        raise UserError("--runid may contain only letters, digits, '.', '_', and '-'")
    while True:
        stamp = time.strftime("%Y%m%d-%H%M%S", time.localtime())
        generated = (
            f"runner-{secrets.token_hex(16)}"
            if runner_handoff
            else f"{stamp}-{os.getpid()}-{secrets.token_hex(3)}"
        )
        runid = requested or generated
        run_dir = os.path.join(root, runid)
        try:
            os.mkdir(run_dir, 0o700)
            return runid, run_dir
        except FileExistsError as error:
            if requested is not None:
                raise UserError(f"--runid is already in use: {runid}") from error


def record_pid(path: str) -> None:
    descriptor = os.open(path, os.O_CREAT | os.O_EXCL | os.O_RDWR, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        payload = f"{os.getpid()}\n".encode("ascii")
        if os.write(descriptor, payload) != len(payload):
            raise OSError("short write while recording launcher pid")
        os.fsync(descriptor)
    except BaseException:
        os.close(descriptor)
        raise


def runner_record(name: str, value: str | int) -> None:
    try:
        print(f"CODEX_DELEGATE_{name}={value}", flush=True)
    except (OSError, ValueError) as error:
        raise UserError(f"cannot publish runner {name.lower()}: {error}") from error


def regular_nonempty(path: str) -> bool:
    try:
        state = os.lstat(path)
    except OSError:
        return False
    return stat.S_ISREG(state.st_mode) and state.st_size > 0


def runner_records(path: str) -> tuple[int | None, str | None, bool]:
    pid: int | None = None
    runid: str | None = None
    ended = False
    if not regular_nonempty(path):
        return pid, runid, ended
    try:
        with open(path, "rb") as output:
            for line in output:
                pid_match = RUNNER_PID_RECORD.fullmatch(line)
                runid_match = RUNNER_RUNID_RECORD.fullmatch(line)
                end_match = RUNNER_END_RECORD.fullmatch(line)
                if pid is None and pid_match is not None:
                    pid = int(pid_match.group(1))
                elif pid is not None and runid is None and runid_match is not None:
                    runid = runid_match.group(1).decode("ascii")
                elif pid is not None and end_match is not None:
                    ended = ended or int(end_match.group(1)) == pid
    except OSError:
        return None, None, False
    return pid, runid, ended


def runner_run_dir(runid: str) -> str:
    root = os.environ.get("CODEX_DELEGATE_HOME", str(Path.home() / ".codex-delegate"))
    return os.path.join(os.path.abspath(root), runid)


def process_exists(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, OverflowError):
        return False
    except PermissionError:
        return True


def pid_lock_released(path: str) -> bool | None:
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            return None
        try:
            fcntl.flock(descriptor, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            return False
        return True
    except OSError:
        return None
    finally:
        os.close(descriptor)


def runner_wait(output_path: str) -> int:
    started = time.monotonic()
    until = started + RUNNER_WAIT_SECONDS
    startup_until = started + RUNNER_STARTUP_SECONDS
    while True:
        pid, runid, ended = runner_records(output_path)
        if runid is None:
            if ended or (pid is not None and not process_exists(pid)):
                print("ENDED")
                return 0
        else:
            run_dir = runner_run_dir(runid)
            lock_released = pid_lock_released(os.path.join(run_dir, "pid"))
            launcher_dead = pid is not None and not process_exists(pid)
            if lock_released is not False and (ended or lock_released is True or launcher_dead):
                print("ENDED")
                return 0
        now = time.monotonic()
        if pid is None and now >= startup_until:
            print("ENDED")
            return 0
        if now >= until:
            print("RUNNING")
            return 0
        time.sleep(0.05)


def write_runner_output(path: str, output: BinaryIO) -> int:
    pid: bytes | None = None
    pid_offset: int | None = None
    runid_offset: int | None = None
    end_offsets: list[int] = []
    written = 0
    with open(path, "rb") as source:
        while True:
            offset = source.tell()
            line = source.readline()
            if not line:
                break
            pid_match = RUNNER_PID_RECORD.fullmatch(line)
            runid_match = RUNNER_RUNID_RECORD.fullmatch(line)
            end_match = RUNNER_END_RECORD.fullmatch(line)
            if pid is None and pid_match is not None:
                pid = pid_match.group(1)
                pid_offset = offset
            elif pid is not None and runid_offset is None and runid_match is not None:
                runid_offset = offset
            elif pid is not None and end_match is not None and end_match.group(1) == pid:
                end_offsets.append(offset)
        skipped = {item for item in (pid_offset, runid_offset) if item is not None}
        if end_offsets:
            skipped.add(end_offsets[-1])
        source.seek(0)
        while True:
            offset = source.tell()
            line = source.readline()
            if not line:
                break
            if offset not in skipped:
                output.write(line)
                written += len(line)
    return written


def runner_report(output_path: str) -> int:
    if not regular_nonempty(output_path):
        print(f"{PROGRAM}: the launcher produced no result in {output_path}")
        return 0
    pid, runid, ended = runner_records(output_path)
    run_dir = runner_run_dir(runid) if runid is not None else None
    lock_released = pid_lock_released(os.path.join(run_dir, "pid")) if run_dir is not None else None
    if lock_released is False:
        raise UserError("runner-report cannot return output while the launcher is still running")
    if not ended and runid is None and pid is not None and process_exists(pid):
        raise UserError("runner-report cannot return output while the launcher is still starting")
    if sys.stdout is None:
        return 0
    try:
        written = write_runner_output(output_path, sys.stdout.buffer)
        sys.stdout.buffer.flush()
    except (OSError, ValueError):
        print(f"{PROGRAM}: the launcher produced no readable result in {output_path}")
        return 0
    if written == 0:
        location = run_dir or "the unresolved runner launch"
        print(f"{PROGRAM}: the launcher ended before it could report; no result for {location}")
    elif (run_dir is None and not ended) or (
        run_dir is not None and not regular_nonempty(os.path.join(run_dir, "status.json"))
    ):
        location = run_dir or "the unresolved runner launch"
        print(
            f"{PROGRAM}: the launcher ended before it could report terminal status; "
            f"preceding output may be incomplete for {location}"
        )
    return 0


def check_prompt_state(notice: SignalNotice, deadline_at: float) -> None:
    if notice["number"] is not None:
        raise PromptStopped(notice["number"])
    if time.monotonic() >= deadline_at:
        raise PromptDeadline


def copy_prompt(
    source: BinaryIO,
    output: BinaryIO,
    read_error: str,
    notice: SignalNotice,
    deadline_at: float,
) -> None:
    try:
        descriptor = source.fileno()
        regular = stat.S_ISREG(os.fstat(descriptor).st_mode)
    except (OSError, ValueError) as error:
        raise UserError(f"{read_error}: {error}") from error
    watcher: selectors.BaseSelector | None = None
    if not regular:
        watcher = selectors.SelectSelector()
        try:
            watcher.register(descriptor, selectors.EVENT_READ)
        except (OSError, ValueError) as error:
            watcher.close()
            raise UserError(f"{read_error}: {error}") from error
    try:
        while True:
            check_prompt_state(notice, deadline_at)
            if watcher is not None and not watcher.select(
                min(0.1, max(0.0, deadline_at - time.monotonic()))
            ):
                continue
            check_prompt_state(notice, deadline_at)
            try:
                chunk = os.read(descriptor, 65536)
            except (OSError, ValueError) as error:
                raise UserError(f"{read_error}: {error}") from error
            if not chunk:
                return
            try:
                written = output.write(chunk)
            except OSError as error:
                raise UserError(f"cannot store prompt: {error}") from error
            if written != len(chunk):
                raise UserError("cannot store prompt: short write")
    finally:
        if watcher is not None:
            watcher.close()


def store_prompt(args: Arguments, path: str, notice: SignalNotice, deadline_at: float) -> None:
    try:
        with open(path, "xb", buffering=0) as output:
            if args.prompt_stdin:
                if sys.stdin is None or sys.stdin.closed:
                    raise UserError("cannot read prompt from stdin: standard input is closed")
                try:
                    os.fstat(sys.stdin.buffer.fileno())
                except OSError as error:
                    if error.errno == errno.EBADF:
                        raise UserError(
                            "cannot read prompt from stdin: standard input is closed"
                        ) from error
                    raise
                copy_prompt(
                    sys.stdin.buffer,
                    output,
                    "cannot read prompt from stdin: reading standard input failed",
                    notice,
                    deadline_at,
                )
            else:
                if args.prompt_file is None:
                    raise UserError("prompt file is required")
                with open(args.prompt_file, "rb") as source:
                    copy_prompt(
                        source,
                        output,
                        "cannot read prompt file",
                        notice,
                        deadline_at,
                    )
            try:
                os.fsync(output.fileno())
            except OSError as error:
                raise UserError(f"cannot store prompt: {error}") from error
    except UserError:
        raise
    except OSError as error:
        raise UserError(f"cannot store prompt: {error}") from error
    if os.path.getsize(path) == 0:
        raise UserError("the prompt is empty")


def codex_argv(
    codex: str,
    args: Arguments,
    model: str,
    effort: str,
    final_path: str,
    cwd: str,
    add_dirs: list[str],
    schema: str | None,
) -> list[str]:
    command = [
        codex,
        "exec",
        "--json",
        "--skip-git-repo-check",
        "-c",
        "approval_policy=never",
        "-c",
        f"model_reasoning_effort={effort}",
        "-m",
        model,
        "-s",
        args.sandbox,
        "-C",
        cwd,
        "-o",
        final_path,
    ]
    for directory in add_dirs:
        command.extend(("--add-dir", directory))
    if schema:
        command.extend(("--output-schema", schema))
    if args.sandbox == "workspace-write":
        command.extend(
            (
                "-c",
                f"sandbox_workspace_write.network_access={'true' if args.network else 'false'}",
                "-c",
                "sandbox_workspace_write.exclude_slash_tmp=true",
                "-c",
                "sandbox_workspace_write.exclude_tmpdir_env_var=true",
                "-c",
                "sandbox_workspace_write.writable_roots=[]",
            )
        )
    command.extend(("--", "-"))
    return command


class Capture:
    def __init__(self, output: BinaryIO) -> None:
        self.output = output
        self.bytes_written = 0
        self.buffer = b""
        self.drop_line = False
        self.write_failed = False
        self.error: str | None = None
        self.terminal: str | None = None
        self.terminal_at: float | None = None
        self.failure_message: str | None = None
        self.message: str | None = None

    def mark_error(self, kind: str) -> None:
        if self.error is None:
            self.error = kind

    def consume_line(self, raw: bytes) -> None:
        if not raw:
            self.mark_error("empty_event_record")
            return
        try:
            event = json.loads(raw)
        except (UnicodeDecodeError, json.JSONDecodeError):
            self.mark_error("malformed_event_record")
            return
        if not isinstance(event, dict) or not isinstance(event.get("type"), str):
            self.mark_error("invalid_event_record")
            return
        kind = event["type"]
        if kind == "item.completed":
            item = event.get("item")
            if isinstance(item, dict):
                text = item.get("text")
                if isinstance(text, str) and item.get("type") == "agent_message":
                    self.message = text
            return
        if kind not in ("turn.completed", "turn.failed"):
            return
        if self.terminal is not None:
            self.mark_error("duplicate_terminal_event")
            return
        self.terminal = kind
        self.terminal_at = time.monotonic()
        if kind == "turn.failed":
            error = event.get("error")
            if isinstance(error, dict) and isinstance(error.get("message"), str):
                self.failure_message = error["message"][:1000]

    def feed(self, chunk: bytes) -> None:
        remaining = EVENT_LIMIT - self.bytes_written
        if remaining > 0 and not self.write_failed:
            stored = chunk[:remaining]
            try:
                written = self.output.write(stored)
            except OSError:
                self.write_failed = True
                self.mark_error("event_stream_write_failed")
            else:
                self.bytes_written += written
                if written != len(stored):
                    self.write_failed = True
                    self.mark_error("event_stream_write_failed")
        if len(chunk) > max(remaining, 0):
            self.mark_error("event_stream_too_large")
        data = chunk
        if self.drop_line:
            split = data.find(b"\n")
            if split < 0:
                return
            data = data[split + 1 :]
            self.drop_line = False
        self.buffer += data
        while b"\n" in self.buffer:
            raw, self.buffer = self.buffer.split(b"\n", 1)
            self.consume_line(raw.rstrip(b"\r"))
        if len(self.buffer) > LINE_LIMIT:
            self.mark_error("event_record_too_large")
            self.buffer = b""
            self.drop_line = True

    def finish(self) -> None:
        if self.buffer or self.drop_line:
            self.mark_error("truncated_event_record")
        if not self.write_failed:
            try:
                self.output.flush()
                os.fsync(self.output.fileno())
            except OSError:
                self.write_failed = True
                self.mark_error("event_stream_write_failed")


def group_exists(pgid: int) -> bool:
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except OSError:
        return True


def signal_group(pgid: int, number: int) -> None:
    try:
        os.killpg(pgid, number)
    except OSError:
        pass


def read_pipe(fd: int, capture: Capture) -> bool:
    for _ in range(READ_BATCH):
        try:
            chunk = os.read(fd, 65536)
        except BlockingIOError:
            break
        except OSError:
            capture.mark_error("event_stream_read_failed")
            break
        if not chunk:
            return True
        capture.feed(chunk)
    return False


def stop_group(process: subprocess.Popen[bytes], fd: int, capture: Capture) -> bool:
    pgid = process.pid
    for number, grace in ((signal.SIGINT, 0.4), (signal.SIGTERM, 1.0), (signal.SIGKILL, 1.0)):
        if not group_exists(pgid):
            break
        signal_group(pgid, number)
        until = time.monotonic() + grace
        while time.monotonic() < until:
            process.poll()
            read_pipe(fd, capture)
            if not group_exists(pgid):
                break
            time.sleep(0.02)
    process.poll()
    read_pipe(fd, capture)
    return not group_exists(pgid)


def atomic_status(path: str, status: Status) -> None:
    temporary = f"{path}.tmp.{os.getpid()}.{secrets.token_hex(4)}"
    with open(temporary, "x", encoding="utf-8") as output:
        json.dump(status, output, indent=2, sort_keys=True)
        output.write("\n")
        output.flush()
        os.fsync(output.fileno())
    os.replace(temporary, path)
    os.chmod(path, 0o400)


def has_final_message(path: str) -> bool:
    try:
        return os.path.isfile(path) and os.path.getsize(path) > 0
    except OSError:
        return False


def discard_stdout_error() -> None:
    try:
        descriptor = sys.stdout.fileno()
        sink = os.open(os.devnull, os.O_WRONLY)
        try:
            os.dup2(sink, descriptor)
        finally:
            os.close(sink)
    except (OSError, ValueError):
        pass


def print_result(final_path: str, status: Status) -> None:
    if sys.stdout is None:
        return
    try:
        print(f"\n--- FINAL MESSAGE ({final_path}) ---", flush=True)
        if status["final_message_path"]:
            with open(final_path, "rb") as final:
                final.seek(-1, os.SEEK_END)
                ends_with_newline = final.read(1) == b"\n"
                final.seek(0)
                shutil.copyfileobj(final, sys.stdout.buffer)
            sys.stdout.buffer.flush()
            if not ends_with_newline:
                print()
        else:
            print(f"(no final message; run verdict is {status['verdict']})")
        print("\n--- STATUS ---")
        print(json.dumps(status, indent=2, sort_keys=True))
        sys.stdout.flush()
    except (OSError, ValueError):
        discard_stdout_error()


def status_for(
    context: RunContext,
    verdict: str,
    code: int,
    diagnostic: str | None,
    signal_name: str | None,
    duration: float,
    process_code: int | None,
    terminal: str | None,
) -> Status:
    final_path = context["final_path"]
    return {
        "schema_version": 1,
        "runid": context["runid"],
        "verdict": verdict,
        "exit_code": code,
        "diagnostic": diagnostic,
        "signal": signal_name,
        "model": context["model"],
        "effort": context["effort"],
        "sandbox": context["sandbox"],
        "deadline_s": context["deadline"],
        "duration_s": round(duration, 6),
        "process_exit_code": process_code,
        "terminal_event": terminal,
        "final_message_path": final_path if has_final_message(final_path) else None,
        "events_path": context["events_path"],
        "stderr_path": context["stderr_path"],
    }


def run(args: Arguments, codex: str, models: list[Model] | None) -> int:
    if args.network and args.sandbox != "workspace-write":
        raise UserError("--network requires --sandbox workspace-write")
    cwd = canonical_dir(args.cwd, "--cwd")
    add_dirs = [canonical_dir(item, "--add-dir") for item in args.add_dir]
    if args.prompt_file is not None:
        args.prompt_file = readable_file(args.prompt_file, "prompt file")
    schema = readable_file(args.schema, "schema") if args.schema else None
    model, effort = resolve_pair(models, args.model, args.effort)
    root = secure_run_root()
    if args.sandbox == "workspace-write":
        for writable in (cwd, *add_dirs):
            if paths_overlap(root, writable):
                raise UserError(f"run storage {root} overlaps writable root {writable}")
    runid, run_dir = allocate_run(root, args.runid, args.runner_handoff)
    record_pid(os.path.join(run_dir, "pid"))
    if args.runner_handoff:
        runner_record("RUNID", runid)
    prompt_path = os.path.join(run_dir, "prompt.txt")
    final_path = os.path.join(run_dir, "final.txt")
    events_path = os.path.join(run_dir, "events.jsonl")
    stderr_path = os.path.join(run_dir, "stderr.log")
    status_path = os.path.join(run_dir, "status.json")
    context: RunContext = {
        "runid": runid,
        "model": model,
        "effort": effort,
        "sandbox": args.sandbox,
        "deadline": args.deadline,
        "final_path": final_path,
        "events_path": events_path,
        "stderr_path": stderr_path,
    }
    notice: SignalNotice = {"number": None, "at": None}

    def stopped(number: int, _frame: FrameType | None) -> None:
        if notice["number"] is None:
            notice["number"] = number
            notice["at"] = time.monotonic()

    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(number, stopped)

    started_mono = time.monotonic()
    deadline_at = started_mono + args.deadline
    try:
        store_prompt(args, prompt_path, notice, deadline_at)
        check_prompt_state(notice, deadline_at)
    except PromptStopped as error:
        staging_signal_name = signal.Signals(error.number).name
        status = status_for(
            context,
            "STOPPED",
            128 + error.number,
            f"received {staging_signal_name} during prompt ingestion",
            staging_signal_name,
            time.monotonic() - started_mono,
            None,
            None,
        )
        atomic_status(status_path, status)
        print_result(final_path, status)
        return 128 + error.number
    except PromptDeadline:
        status = status_for(
            context,
            "DEADLINE",
            EXIT["DEADLINE"],
            f"wall-clock deadline of {args.deadline}s expired during prompt ingestion",
            None,
            time.monotonic() - started_mono,
            None,
            None,
        )
        atomic_status(status_path, status)
        print_result(final_path, status)
        return EXIT["DEADLINE"]
    except UserError as error:
        print(f"{PROGRAM}: {error}", file=sys.stderr)
        status = status_for(
            context,
            "LAUNCH_ERROR",
            EXIT["LAUNCH_ERROR"],
            str(error),
            None,
            time.monotonic() - started_mono,
            None,
            None,
        )
        atomic_status(status_path, status)
        print_result(final_path, status)
        return EXIT["LAUNCH_ERROR"]

    command = codex_argv(codex, args, model, effort, final_path, cwd, add_dirs, schema)
    with (
        open(prompt_path, "rb") as prompt,
        open(events_path, "xb", buffering=0) as events,
        open(stderr_path, "xb") as stderr,
    ):
        capture = Capture(events)
        try:
            process = subprocess.Popen(  # noqa: S603 -- Run the constructed Codex argv, no shell.
                command,
                stdin=prompt,
                stdout=subprocess.PIPE,
                stderr=stderr,
                cwd=cwd,
                start_new_session=True,
                close_fds=True,
            )
        except OSError as error:
            capture.finish()
            launch_diagnostic = f"could not launch Codex: {error}"
            status = status_for(
                context,
                "LAUNCH_ERROR",
                EXIT["LAUNCH_ERROR"],
                launch_diagnostic,
                None,
                time.monotonic() - started_mono,
                None,
                None,
            )
            atomic_status(status_path, status)
            print_result(final_path, status)
            return EXIT["LAUNCH_ERROR"]

        fd = cast(BinaryIO, process.stdout).fileno()
        watcher: selectors.BaseSelector | None = None
        process_code: int | None = None
        outcome = "stream_error"
        clean = False
        try:
            os.set_blocking(fd, False)
            watcher = selectors.DefaultSelector()
            watcher.register(fd, selectors.EVENT_READ)
            eof = False
            waiting = True
            while waiting:
                now = time.monotonic()
                timeout = min(0.1, max(0.0, deadline_at - now))
                if watcher.select(timeout):
                    eof = read_pipe(fd, capture) or eof
                process_code = process.poll()
                now = time.monotonic()
                candidates: list[tuple[float, str]] = []
                if capture.terminal_at is not None:
                    candidates.append((capture.terminal_at, "terminal"))
                if notice["at"] is not None:
                    candidates.append((notice["at"], "signal"))
                if now >= deadline_at:
                    candidates.append((deadline_at, "deadline"))
                if process_code is not None and eof:
                    candidates.append((now, "exit"))
                if candidates:
                    outcome = min(candidates, key=lambda item: item[0])[1]
                    waiting = False

            if outcome == "terminal":
                settle_until = time.monotonic() + TERMINAL_SETTLE_LIMIT_SECONDS
                while process.poll() is None:
                    now = time.monotonic()
                    if now >= settle_until:
                        break
                    if watcher.select(min(0.05, settle_until - now)):
                        read_pipe(fd, capture)
        except OSError:
            capture.mark_error("event_stream_read_failed")
        finally:
            clean = stop_group(process, fd, capture)
            try:
                process_code = process.wait(timeout=1)
            except (OSError, subprocess.TimeoutExpired):
                process_code = None
                clean = False
            read_pipe(fd, capture)
            capture.finish()
            if watcher is not None:
                try:
                    watcher.close()
                except OSError:
                    capture.mark_error("event_stream_read_failed")

    if capture.message and not has_final_message(final_path):
        try:
            with open(final_path, "w", encoding="utf-8") as final:
                final.write(capture.message)
        except (OSError, UnicodeError):
            capture.mark_error("final_message_write_failed")

    signal_number = notice["number"]
    signal_name = (
        signal.Signals(signal_number).name
        if outcome == "signal" and signal_number is not None
        else None
    )
    verdict: str
    diagnostic: str | None
    code: int
    if not clean:
        verdict, diagnostic = "CLEANUP_FAILED", "the Codex process group survived SIGKILL"
        code = EXIT[verdict]
    elif outcome == "signal" and signal_number is not None:
        verdict, diagnostic = "STOPPED", f"received {signal_name}"
        code = 128 + signal_number
    elif outcome == "deadline":
        verdict, diagnostic = "DEADLINE", f"wall-clock deadline of {args.deadline}s expired"
        code = EXIT[verdict]
    elif capture.error is not None:
        verdict, diagnostic = "STREAM_ERROR", capture.error
        code = EXIT[verdict]
    elif capture.terminal == "turn.failed":
        verdict, diagnostic = "FAILED", capture.failure_message or "Codex emitted turn.failed"
        code = EXIT[verdict]
    elif capture.terminal == "turn.completed":
        if has_final_message(final_path):
            verdict, diagnostic = "COMPLETED", None
            code = EXIT[verdict]
        else:
            verdict, diagnostic = "OUTPUT_MISSING", "Codex completed without emitting a message"
            code = EXIT[verdict]
    else:
        verdict, diagnostic = (
            "NO_TERMINAL_EVENT",
            "Codex exited without turn.completed or turn.failed",
        )
        code = EXIT[verdict]
    status = status_for(
        context,
        verdict,
        code,
        diagnostic,
        signal_name,
        time.monotonic() - started_mono,
        process_code,
        capture.terminal,
    )
    atomic_status(status_path, status)
    print_result(final_path, status)
    return code


def main() -> int:
    os.umask(0o077)
    if platform.system() != "Darwin":
        print(
            f"{PROGRAM}: unsupported platform {platform.system()}; macOS is required",
            file=sys.stderr,
        )
        return EXIT["PLATFORM_UNSUPPORTED"]
    if sys.argv[1:2] == ["runner-wait"]:
        if len(sys.argv) != 3:
            raise UserError("runner-wait requires exactly one harness output file")
        return runner_wait(sys.argv[2])
    if sys.argv[1:2] == ["runner-report"]:
        if len(sys.argv) != 3:
            raise UserError("runner-report requires exactly one harness output file")
        return runner_report(sys.argv[2])
    args = parser().parse_args(namespace=Arguments())
    if args.command == "run" and args.runner_handoff and args.runid is not None:
        raise UserError("--runner-handoff cannot be combined with --runid")
    codex = shutil.which("codex")
    if codex is None:
        raise UserError("codex is not on PATH")
    models: list[Model] | None
    if args.command == "models":
        models = catalog(codex)
        print("slug\tdefault_effort\treasoning_efforts")
        for model in models:
            print(f"{model['slug']}\t{model['default']}\t{','.join(model['efforts'])}")
        return 0
    try:
        models = catalog(codex)
    except UserError as error:
        if args.model is None or args.effort is None:
            raise
        print(
            f"{PROGRAM}: warning: {error}; proceeding with the caller's explicit pair unvalidated",
            file=sys.stderr,
        )
        models = None
    return run(args, codex, models)


def entrypoint() -> int:
    runner_mode = sys.argv[1:2] == ["run"] and "--runner-handoff" in sys.argv[2:]
    if runner_mode:
        runner_record("LAUNCHER_PID", os.getpid())
    try:
        try:
            return main()
        except UserError as error:
            return fail(str(error))
    finally:
        if runner_mode:
            try:
                runner_record("LAUNCHER_ENDED", os.getpid())
            except UserError:
                pass


raise SystemExit(entrypoint())
